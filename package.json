{
  "name": "rocketflare",
  "version": "0.34.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketflare — multi-tenant SaaS for internal tools and B2B products — pnpm workspace: apps/web (Hono API + React UI on Cloudflare Workers), apps/cli, packages/shared",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --silent --filter @rocketflare/web dev",
    "dev:stop": "pnpm --filter @rocketflare/web dev:stop",
    "dev:status": "pnpm --filter @rocketflare/web dev:status",
    "dev:tunnel": "pnpm --filter @rocketflare/web dev:tunnel",
    "dev:db:up": "pnpm --filter @rocketflare/web dev:db:up",
    "dev:db:down": "pnpm --filter @rocketflare/web dev:db:down",
    "dev:db:status": "pnpm --filter @rocketflare/web dev:db:status",
    "bootstrap": "node scripts/bootstrap.mjs",
    "kit:upgrade": "node scripts/upgrade.mjs",
    "kit:release": "node scripts/release.mjs",
    "plugin": "node scripts/plugin.mjs",
    "preflight": "node scripts/bootstrap.mjs --check",
    "security:sandbox": "node scripts/security-sandbox.mjs",
    "test:db:up": "pnpm --filter @rocketflare/web test:db:up",
    "test:db:down": "pnpm --filter @rocketflare/web test:db:down",
    "db:generate": "pnpm --filter @rocketflare/web db:generate",
    "db:migrate": "pnpm --filter @rocketflare/web db:migrate",
    "db:migrate:ci": "pnpm --filter @rocketflare/web db:migrate:ci",
    "db:studio": "pnpm --filter @rocketflare/web db:studio",
    "seed": "pnpm --filter @rocketflare/web seed",
    "types": "pnpm --filter @rocketflare/web types",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "gate": "node scripts/gate.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs",
    "test:coverage": "pnpm -r test:coverage",
    "eval": "pnpm --silent --filter @rocketflare/evals eval",
    "eval:baseline": "pnpm --silent --filter @rocketflare/evals eval:baseline",
    "eval:view": "pnpm --silent --filter @rocketflare/evals eval:view",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "clean:deep": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "web": "pnpm --filter @rocketflare/web",
    "cli": "pnpm --filter @rocketflare/cli exec tsx src/cli.ts",
    "deploy": "pnpm --filter @rocketflare/web deploy",
    "deploy:staging": "pnpm --filter @rocketflare/web deploy:staging",
    "provision": "pnpm --filter @rocketflare/web provision"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
