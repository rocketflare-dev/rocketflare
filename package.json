{
  "name": "gmgo",
  "version": "0.1.0",
  "private": true,
  "description": "GM multi-tenant SaaS starter kit — pnpm workspace: apps/web (Hono API + React UI on Cloudflare Workers), apps/cli, packages/shared",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @gmgo/web dev",
    "dev:tunnel": "pnpm --filter @gmgo/web dev:tunnel",
    "dev:db:up": "pnpm --filter @gmgo/web dev:db:up",
    "dev:db:down": "pnpm --filter @gmgo/web dev:db:down",
    "test:db:up": "pnpm --filter @gmgo/web test:db:up",
    "test:db:down": "pnpm --filter @gmgo/web test:db:down",
    "db:generate": "pnpm --filter @gmgo/web db:generate",
    "db:migrate": "pnpm --filter @gmgo/web db:migrate",
    "db:migrate:ci": "pnpm --filter @gmgo/web db:migrate:ci",
    "db:studio": "pnpm --filter @gmgo/web db:studio",
    "seed": "pnpm --filter @gmgo/web seed",
    "types": "pnpm --filter @gmgo/web types",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "clean:deep": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "web": "pnpm --filter @gmgo/web",
    "cli": "pnpm --filter @gmgo/cli exec tsx src/cli.ts",
    "deploy": "pnpm --filter @gmgo/web deploy",
    "deploy:staging": "pnpm --filter @gmgo/web deploy:staging",
    "provision": "pnpm --filter @gmgo/web provision"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
