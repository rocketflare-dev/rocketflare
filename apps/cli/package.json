{
  "name": "@rocketflare/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketflare command-line interface (login via browser → API key, whoami, tenant-scoped commands)",
  "type": "module",
  "bin": {
    "rocketflare": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --sourcemap --external:chalk --external:commander --external:open --external:zod --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rocketflare/shared": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.5"
  }
}
