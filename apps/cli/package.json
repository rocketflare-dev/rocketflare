{
  "name": "@rocketflare/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Rocketflare kit command-line interface (login via browser → API key, whoami, tenant-scoped commands)",
  "type": "module",
  "bin": {
    "rocketflare": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --sourcemap --external:chalk --external:commander --external:open --external:zod --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@rocketflare/shared": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
