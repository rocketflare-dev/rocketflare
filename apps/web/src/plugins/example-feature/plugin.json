{
  "id": "example-feature",
  "label": "Example feature",
  "version": "0.1.0",
  "repo": "https://github.com/rocketflare-dev/rocketflare.git",
  "subdir": "",
  "anchor": "apps/web/src/plugins/example-feature/plugin.json",
  "minKit": "0.8.0",
  "uses": {
    "@/plugins/api": [
      "agentCtx",
      "createRouter",
      "Database",
      "defineTool",
      "DeliveredEvent",
      "eventBinding",
      "eventCtx",
      "EventCtx",
      "EventHandler",
      "EventName",
      "EventPayload",
      "eventTrigger",
      "HookCtx",
      "identityFor",
      "jobCtx",
      "JobCtx",
      "JobHandler",
      "listBindableAgents",
      "PluginAgent",
      "PluginConfig",
      "provisionFor",
      "PUBLIC_MOUNT_ROOT",
      "publicCtx",
      "PublicCtx",
      "recordActivity",
      "requestCtx",
      "RequestCtx",
      "requireFeature",
      "SeedCtx",
      "ServerPlugin",
      "signState",
      "SsoRequirement",
      "Tool",
      "toolCtx",
      "ToolCtx",
      "validate",
      "verifyState"
    ],
    "@/plugins/api/peers": ["allTables"],
    "@/plugins/api/ui-wiring": ["featureGuard", "NavGuard", "UiPlugin"],
    "@/plugins/api/ui": [
      "api",
      "EmptyState",
      "SectionPanel",
      "showToast",
      "SideNav",
      "useAuth",
      "usePermissions"
    ],
    "@/db/schema/kit": [
      "activityEvents",
      "tenantIsolation",
      "tenantRef",
      "tenants",
      "timestamps",
      "users"
    ],
    "'../api' (apps/cli/src/plugins/api.ts)": [
      "CliPlugin",
      "CommandContext",
      "formatDate",
      "formatPagination",
      "neutralise",
      "renderTable",
      "requireClient"
    ],
    "@testkit/integration": [
      "bearerHeader",
      "createTestApiKey",
      "createTestEnv",
      "createTestSession",
      "createTestTenant",
      "createTestUser",
      "deliverEvents",
      "json",
      "linkUserToTenant",
      "makeSession",
      "makeUser",
      "renderWithProviders",
      "request",
      "rulesFor",
      "sessionCookieHeader",
      "setupTestDatabase",
      "stubs",
      "uniqueId"
    ],
    "@testkit/unit": ["makeCronCtx", "makeJobCtx", "makeToolCtx"],
    "@rocketflare/shared/features": ["FEATURE_FLAGS", "FEATURE_KEYS", "FeatureDefinition"],
    "@rocketflare/shared/jobs": ["CoreJobType", "JOB_TYPES", "jobInputSchema", "JobOf", "JobType"],
    "@rocketflare/shared/pagination": [
      "paginatedResponse",
      "PaginationQuery",
      "paginationQuerySchema"
    ],
    "@rocketflare/shared/permissions": ["Subjects"],
    "@rocketflare/shared/plugins": ["pluginNamespace"],
    "@rocketflare/shared/plugins/types": ["SharedPlugin"]
  },
  "paths": [
    "apps/web/src/plugins/example-feature/**",
    "packages/shared/src/plugins/example-feature/**",
    "apps/cli/src/plugins/example-feature/**",
    ".claude/skills/example-feature/**"
  ],
  "registries": [
    "apps/web/src/plugins/server.ts",
    "apps/web/src/plugins/ui.ts",
    "apps/web/src/plugins/schema.ts",
    "packages/shared/src/plugins/index.ts",
    "apps/cli/src/plugins/index.ts"
  ],
  "requires": { "surfaces": [], "plugins": [] },
  "dependencies": { "apps/web": {}, "packages/shared": {}, "apps/cli": {} },
  "bindings": [],
  "crons": [],
  "apiPrefixes": [],
  "vars": [],
  "workerExports": [],
  "skills": ["example-feature"],
  "events": ["example-feature.note.created"],
  "schema": { "tables": ["example_notes"], "rlsExcluded": [] },
  "migrations": ["example_notes, tenant-scoped, RLS policy"]
}
