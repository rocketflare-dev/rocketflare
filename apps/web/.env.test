# Test environment (dummy values only — safe to commit). Loaded by `pnpm test` via dotenv-cli.
NODE_ENV=test
APP_ENV=development
APP_URL=http://localhost:3001
APP_NAME=Rocketflare Test
LOG_LEVEL=silent
TENANCY_MODE=multi
SIGNUP_MODE=invite_only

# Test database (docker-compose.test.yml, host port 5433)
DATABASE_URL=postgresql://test:test@localhost:5433/rocketflare_test
# App role used by RLS policies. Created NOLOGIN by db-roles.ts when the credential is unset;
# tests run predicates-only (TENANT_SCOPE_MODE=off) — see docs/RLS.md for the enforce spike.
APP_DATABASE_URL=postgresql://rocketflare_app:test_app@localhost:5433/rocketflare_test
TENANT_SCOPE_MODE=off

OAUTH_ENCRYPTION_KEY=test_encryption_key_0000000000000000000000000000000000000000000000
AUTH_SIGNING_KEY=test_signing_key_00000000000000000000000000000000000000000000000000

GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
MICROSOFT_CLIENT_ID=test_microsoft_client_id
MICROSOFT_CLIENT_SECRET=test_microsoft_client_secret
