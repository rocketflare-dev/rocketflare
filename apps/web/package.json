{
  "name": "@rocketflare/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketflare kit web app: Hono API + React UI on Cloudflare Workers, Postgres (Neon via Hyperdrive) + Drizzle",
  "type": "module",
  "cfld": {
    "name": "rocketflare",
    "port": 3000
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs --start",
    "dev:stop": "node scripts/dev-server.mjs --stop",
    "dev:status": "node scripts/dev-server.mjs --status",
    "dev:api": "mkdir -p dist/ui && node scripts/dev-db.mjs env -- wrangler dev --port 3001",
    "dev:ui": "vite",
    "dev:tunnel": "cfld -- node scripts/tunnel-dev.mjs",
    "dev:db:up": "node scripts/dev-db.mjs up",
    "dev:db:down": "node scripts/dev-db.mjs down",
    "dev:db:status": "node scripts/dev-db.mjs status",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "pnpm types && tsc --noEmit",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "build": "pnpm typecheck && pnpm build:ui && pnpm build:api",
    "build:ui": "vite build",
    "build:api": "wrangler deploy --dry-run --outdir dist/api",
    "clean": "rm -rf dist coverage .wrangler",
    "test": "pnpm test:shared && pnpm test:isolated",
    "test:shared": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api --no-isolate",
    "test:isolated": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated --project ui --project config",
    "test:api": "pnpm test:shared && NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated",
    "test:ui": "NODE_ENV=test dotenv -e .env.test -- vitest run --project ui",
    "test:config": "NODE_ENV=test dotenv -e .env.test -- vitest run --project config",
    "test:coverage": "NODE_ENV=test dotenv -e .env.test -- vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "db:generate": "dotenv -e .dev.vars -- drizzle-kit generate",
    "db:migrate": "dotenv -e .dev.vars -- tsx scripts/db-roles.ts --phase=role && dotenv -e .dev.vars -- tsx scripts/migrate.ts && dotenv -e .dev.vars -- tsx scripts/db-roles.ts --phase=grants",
    "db:migrate:ci": "tsx scripts/db-roles.ts --phase=role && tsx scripts/migrate.ts && tsx scripts/db-roles.ts --phase=grants",
    "db:roles": "dotenv -e .dev.vars -- tsx scripts/db-roles.ts",
    "db:studio": "dotenv -e .dev.vars -- drizzle-kit studio",
    "db:check": "dotenv -e .dev.vars -- tsx scripts/test-db-connection.ts",
    "db:refresh-facts": "dotenv -e .dev.vars -- tsx scripts/refresh-fact-tables.ts",
    "db:check-facts": "dotenv -e .dev.vars -- tsx scripts/check-fact-table-freshness.ts",
    "seed": "dotenv -e .dev.vars -- tsx scripts/seed.ts",
    "deploy": "pnpm build:ui && wrangler deploy",
    "deploy:staging": "pnpm build:ui && wrangler deploy -c wrangler.staging.toml",
    "provision": "tsx scripts/provision.ts",
    "provision:cloudflare": "bash scripts/cf-provision.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@casl/ability": "^6.8.1",
    "@casl/react": "^5.0.1",
    "@rocketflare/shared": "workspace:*",
    "@heroicons/react": "^2.2.0",
    "@hono/zod-validator": "^0.7.6",
    "@tanstack/react-query": "^5.102.8",
    "arctic": "^3.7.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "drizzle-cube": "0.8.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.4",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cliftonc/cfld": "^0.2.5",
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.2",
    "daisyui": "^5.7.23",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
