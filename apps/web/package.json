{
  "name": "@rocketflare/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketflare web app: Hono API + React UI on Cloudflare Workers, Postgres (Neon serverless or Hyperdrive) + Drizzle",
  "type": "module",
  "cfld": {
    "name": "rocketflare",
    "port": 3000
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs --start",
    "dev:stop": "node scripts/dev-server.mjs --stop",
    "dev:status": "node scripts/dev-server.mjs --status",
    "dev:api": "mkdir -p dist/ui && node scripts/dev-db.mjs env -- wrangler dev --port ${DEV_API_PORT:-3001}",
    "dev:ui": "vite",
    "dev:tunnel": "node scripts/cfld.mjs -- node scripts/tunnel-dev.mjs",
    "cfld": "node scripts/cfld.mjs",
    "dev:db:up": "node scripts/dev-db.mjs up",
    "dev:db:down": "node scripts/dev-db.mjs down",
    "dev:db:status": "node scripts/dev-db.mjs status",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "typecheck": "pnpm types && tsc --noEmit",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "build": "pnpm build:ui && pnpm build:api",
    "build:ui": "vite build",
    "build:api": "wrangler deploy --dry-run --outdir dist/api",
    "clean": "rm -rf dist coverage .wrangler",
    "test": "pnpm test:shared && pnpm test:isolated",
    "test:shared": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api --no-isolate",
    "test:isolated": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated --project driver --project ui --project config --project kit-only",
    "test:api": "pnpm test:shared && NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated",
    "test:driver": "NODE_ENV=test dotenv -e .env.test -- vitest run --project driver",
    "test:ui": "NODE_ENV=test dotenv -e .env.test -- vitest run --project ui",
    "test:config": "NODE_ENV=test dotenv -e .env.test -- vitest run --project config",
    "test:kit-only": "NODE_ENV=test dotenv -e .env.test -- vitest run --project kit-only",
    "test:coverage": "NODE_ENV=test dotenv -e .env.test -- vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:up:neon": "docker compose -f docker-compose.test.yml --profile neon up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml --profile neon down",
    "db:generate": "dotenv -e .dev.vars -- drizzle-kit generate",
    "db:migrate": "dotenv -e .dev.vars -- tsx scripts/db-roles.ts --phase=role && dotenv -e .dev.vars -- tsx scripts/migrate.ts && dotenv -e .dev.vars -- tsx scripts/db-roles.ts --phase=grants",
    "db:migrate:ci": "tsx scripts/db-roles.ts --phase=role && tsx scripts/migrate.ts && tsx scripts/db-roles.ts --phase=grants",
    "db:roles": "dotenv -e .dev.vars -- tsx scripts/db-roles.ts",
    "db:studio": "dotenv -e .dev.vars -- drizzle-kit studio",
    "db:check": "dotenv -e .dev.vars -- tsx scripts/test-db-connection.ts",
    "seed": "dotenv -e .dev.vars -- tsx scripts/seed.ts",
    "agent:replay": "dotenv -e .dev.vars -- tsx scripts/agent-replay.ts",
    "deploy": "pnpm build:ui && wrangler deploy",
    "deploy:staging": "pnpm build:ui && wrangler deploy -c wrangler.staging.toml",
    "provision": "tsx scripts/provision.ts",
    "provision:cloudflare": "bash scripts/cf-provision.sh"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.4",
    "@ag-ui/encoder": "1.0.4",
    "@ag-ui/proto": "1.0.4",
    "@anthropic-ai/sdk": "^1.3.0",
    "@casl/ability": "^7.1.1",
    "@heroicons/react": "^2.2.0",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@rocketflare/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "hono-pino": "^0.10.3",
    "jose": "^6.2.14",
    "openid-client": "6.8.9",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cliftonc/cfld": "^0.2.7",
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.105.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "daisyui": "^5.7.50",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
